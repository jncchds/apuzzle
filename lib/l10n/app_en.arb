  "exCagesRequiredRow": "Every way to fill the {clue} cage at {cage} puts {values} into its cells in row {row}, so not into {cell}.",
  "@exCagesRequiredRow": {"placeholders": {"clue": {}, "cage": {}, "values": {}, "row": {}, "cell": {}}},
  "exCagesRequiredCol": "Every way to fill the {clue} cage at {cage} puts {values} into its cells in column {col}, so not into {cell}.",
