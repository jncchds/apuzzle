  "@exMercuryRefutedFull": {"placeholders": {"cell": {}}},
  "exMercuryRefutedEmpty": "{cell} is filled: leaving it empty leads to a contradiction.",
  "@exMercuryRefutedEmpty": {"placeholders": {"cell": {}}},
